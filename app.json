{
  "expo": {
    "name": "OXY Real",
    "slug": "secondself",
    "scheme": "oxyreal",
    "version": "1.0.15",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#002b4d"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#002b4d"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "versionCode": 16,
      "package": "com.oxyreal.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "OXY Real",
      "description": "Chat con OXY, Memory Vault e Power Badges"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "OXY Real ha bisogno della fotocamera per scattare foto e analizzarle con Vision AI.",
          "photosPermission": "OXY Real ha bisogno dell'accesso alle foto per analizzarle con Vision AI."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "OXY Real ha bisogno del microfono per registrare messaggi vocali."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "612d5c63-62b3-4890-a6da-66703911c722"
      },
      "firebase": {
        "apiKey": "AIzaSyCHPkYuKdsKcWQyLC1c6ncG5WfHVSAI034",
        "authDomain": "oxy-real.firebaseapp.com",
        "projectId": "oxy-real",
        "storageBucket": "oxy-real.firebasestorage.app",
        "messagingSenderId": "304780647729",
        "appId": "1:304780647729:web:ec3ca14c6fbd7db707e410"
      }
    }
  }
}
