# OXY Real Backend — copia in .env e compila con i tuoi valori.
# Non committare mai .env (contiene segreti).

PORT=3030

# OpenAI (obbligatorio per Master e/o fallback)
OPENAI_API_KEY=

# Tavily (ricerca web)
TAVILY_API_KEY=

# Email dell'utente Master (chiavi server + accesso login senza obbligo consensi checkbox)
MASTER_EMAIL=

# Firebase Admin — path al file JSON del service account (da Firebase Console)
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Opzione B: JSON in base64 (deploy senza file su disco; codifica il JSON del service account)
# FIREBASE_SERVICE_ACCOUNT_JSON=<base64 del file JSON>

# Stripe (pagamenti abbonamenti/Lifetime) — opzionale, attivo solo se configurato
# Secret Key da Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_xxxxx

# Price ID Stripe per ogni piano (da Stripe Dashboard → Products → [piano] → Pricing → Price ID)
STRIPE_PRICE_SUB_STARTER=price_xxxxx
STRIPE_PRICE_SUB_PRO=price_xxxxx
STRIPE_PRICE_SUB_ELITE=price_xxxxx
STRIPE_PRICE_LIFE_STARTER=price_xxxxx
STRIPE_PRICE_LIFE_PRO=price_xxxxx
STRIPE_PRICE_LIFE_ELITE=price_xxxxx

# URL di redirect dopo pagamento Stripe (es. https://oxyreal.it/success e /cancel)
STRIPE_SUCCESS_URL=https://oxyreal.it/success
STRIPE_CANCEL_URL=https://oxyreal.it/cancel
