# OXY Real Backend — copia in .env e compila con i tuoi valori.
# Non committare mai .env (contiene segreti).

PORT=3030

# Con moduleName Studio: log console del system prompt completo (default attivo). Imposta 0 per solo riga riepilogo.
# OXY_LOG_STUDIO_PROMPT=0

# Storage persistente (P0 su Render)
# Il backend salva chat/memoria/diario su filesystem. Su Render senza Persistent Disk i dati possono sparire a restart/redeploy.
# Attacca un Persistent Disk e punta DATA_ROOT al mount path (es. /var/data o /opt/render/project/src/backend/data).
# Se non impostata, usa ./data (accettabile solo in locale o con disk montato proprio lì).
DATA_ROOT=

# OpenAI (obbligatorio per Master e/o fallback)
OPENAI_API_KEY=
# Modelli: OXY Pass sul server = OPENAI_MODEL_OXY_PASS (default gpt-4o). Pacchetti token / BYOK con chiave OpenAI utente = OPENAI_MODEL_STARTER (mini).
# OPENAI_MODEL_OXY_PASS=gpt-4o
# OPENAI_MODEL_STARTER=gpt-4o-mini
# OPENAI_CHAT_MODEL=gpt-4o-mini
# Legacy (se presente nel deploy, viene ancora letto come fallback per OPENAI_MODEL_OXY_PASS):
# OPENAI_MODEL_ELITE=gpt-4-turbo

# Tavily (ricerca web) — obbligatorio per risultati partite, notizie, dati in tempo reale
TAVILY_API_KEY=

# Email dell'utente Master (chiavi server + accesso login senza obbligo consensi checkbox)
MASTER_EMAIL=

# Brevo (Sendinblue) — lista attesa landing oxyreal.it (endpoint /api/landing/newsletter)
BREVO_API_KEY=

# Codice proprietario (opzionale): abilita accesso senza limiti all'account che lo riscatta.
# Endpoint: POST /api/billing/redeem-owner-code con body { "code": "..." } e Bearer token utente.
OWNER_ACCESS_CODE=

# --- Limiti per test veloce (nuovo account, prova 429 / Evolvi Ora) ---
# Imposta BILLING_QUICK_TEST_LIMITS=5 (o altro 1–100).
# Tutti i piani subscription useranno 5 messaggi/giorno: raggiungi il limite in pochi invii.
# BILLING_QUICK_TEST_LIMITS=5

# Firebase Admin — path al file JSON del service account (da Firebase Console)
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Opzione B: JSON in base64 (deploy senza file su disco; codifica il JSON del service account)
# FIREBASE_SERVICE_ACCOUNT_JSON=<base64 del file JSON>

# Stripe (pagamenti abbonamenti/Lifetime) — opzionale, attivo solo se configurato
# Secret Key da Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_xxxxx

# Webhook secret per verificare la firma (Stripe Dashboard → Developers → Webhooks → Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Limite messaggi/giorno solo per OXY Pass (chiave server). BYOK non ha tetto lato piattaforma sulla chat.
# Default 400 se non impostato. Fallback legacy: DAILY_LIMIT_ELITE.
# DAILY_LIMIT_OXY_PASS=400
# Se BILLING_QUICK_TEST_LIMITS è impostato, quel valore sovrascrive il limite Pass (test rapido).

# Price ID Stripe — OXY v2 (tre piani)
STRIPE_PRICE_OXY_MONTHLY=price_xxxxx
STRIPE_PRICE_OXY_SEMIANNUAL=price_xxxxx
STRIPE_PRICE_OXY_ANNUAL=price_xxxxx
# Pacchetti token (opzionale; se non usati, ometti)
# STRIPE_PRICE_PACK_100K=price_xxxxx
# STRIPE_PRICE_PACK_500K=price_xxxxx

# URL di redirect dopo pagamento Stripe. Per l'app mobile usa il deep link così riapre l'app (evita "pagina non trovata"):
# STRIPE_SUCCESS_URL=oxyreal://billing/success
# STRIPE_CANCEL_URL=oxyreal://billing/cancel
# Se hai una pagina web reale: https://oxyreal.it/success e https://oxyreal.it/cancel
STRIPE_SUCCESS_URL=oxyreal://billing/success
STRIPE_CANCEL_URL=oxyreal://billing/cancel

# Invio automatico documenti via email (opzionale)
# NOTA: consigliato tenere disattivato e usare Mail Composer lato app.
DOCS_EMAIL_AUTOSEND_ENABLED=false
# Email di benvenuto dopo pagamento Stripe (stesso SMTP). Se true, invia welcome email al completamento checkout.
WELCOME_EMAIL_AFTER_PAYMENT=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="OXY Real <no-reply@oxyreal.it>"
