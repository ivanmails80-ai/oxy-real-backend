# IMAP (casella da cui leggere le email di supporto)
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USE_TLS=true
IMAP_USER=support@oxyreal.app
IMAP_PASSWORD=tua_password_imap

# OpenAI (per capire la problematica e generare la risposta)
OPENAI_API_KEY=sk-...
# Modello opzionale (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Invio risposte: se SEND_REPLIES=true usa SMTP per inviare; altrimenti salva in cartella replies/
SEND_REPLIES=false
SUPPORT_FROM_EMAIL=support@oxyreal.app

# SMTP (solo se SEND_REPLIES=true)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=support@oxyreal.app
SMTP_PASSWORD=tua_password_smtp

# Opzionale: cartella dove salvare le risposte quando SEND_REPLIES=false (default: ./replies)
# REPLY_OUTPUT_DIR=./replies

# Opzionale: intervallo tra un controllo e l'altro in millisecondi (default: 300000 = 5 min)
# POLL_INTERVAL_MS=300000
