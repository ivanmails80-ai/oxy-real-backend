# OXY Real — App. Copia in .env e compila. Non committare .env (contiene segreti).
# Build produzione (EAS): NON aggiungere EXPO_PUBLIC_OXY_AI_KEY né EXPO_PUBLIC_TAVILY_API_KEY (chiavi solo sul backend).

# Backend (obbligatorio per Master senza chiave in app e per cronologia chat)
EXPO_PUBLIC_BACKEND_URL=http://TUO_IP_O_HOST:3030

# Firebase (autenticazione)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In (login social): Web client ID da Firebase Console → Authentication → Sign-in method → Google → Web SDK
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com

# Master: email che usa le chiavi del backend (opzionale se usi solo backend)
EXPO_PUBLIC_MASTER_EMAIL=

# Distribuzione app: 'subscription' = abbonamento (Oxy Key nascosta, chiave solo sul server) | 'one_time_purchase' = acquisto senza abbonamento (mostra "Inserisci Oxy Key")
# Default: subscription (nessuna chiave sul telefono)
# EXPO_PUBLIC_APP_MODE=subscription
# EXPO_PUBLIC_APP_MODE=one_time_purchase

# Ospiti: chiave OpenAI in app (opzionale se tutti usano backend con propria chiave)
# EXPO_PUBLIC_OXY_AI_KEY=
# Tavily (ricerca web) in app — opzionale se usi solo backend
# EXPO_PUBLIC_TAVILY_API_KEY=
