# OXY Real — App. Copia in .env e compila. Non committare .env (contiene segreti).
# Build produzione (EAS): NON aggiungere EXPO_PUBLIC_OXY_AI_KEY né EXPO_PUBLIC_TAVILY_API_KEY (chiavi solo sul backend).

# ========== VARIABILI MINIME PER GO-LIVE GRATUITO (Fase 1) ==========
# Copia questo blocco in .env e compila i valori. Per EAS Build imposta le stesse variabili in EAS Dashboard → Secrets.
#
# EXPO_PUBLIC_BACKEND_URL=https://oxy-real-backend.onrender.com
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=oxy-real.firebaseapp.com
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=oxy-real
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=oxy-real.firebasestorage.app
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
# (Opzionale per login Google su APK: EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=...)
# ==========

# Backend (obbligatorio per chat, cronologia, Memory Vault, Diario)
EXPO_PUBLIC_BACKEND_URL=http://TUO_IP_O_HOST:3030

# Firebase (autenticazione) — da Firebase Console → Impostazioni progetto
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In (login social)
# Expo Go — ERRORE 400 redirect_uri mismatch? In Google Cloud Console:
#   1. Credentials → OAuth 2.0 Client IDs → il client di tipo "Web application" (quello usato qui sotto).
#   2. In "Authorized redirect URIs" aggiungi ESATTAMENTE (sostituisci TUO_USERNAME con il tuo account Expo):
#      https://auth.expo.io/@TUO_USERNAME/secondself
#   3. Salva. Riavvia l'app e riprova.
# Poi nel client "Web application" copia Client ID e incollalo qui:
# EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=xxxx.apps.googleusercontent.com
#
# APK Android (build release locale o EAS): crea un OAuth Client ID di tipo "Android" con:
# - Nome pacchetto: com.oxyreal.app
# - Impronta SHA-1 (debug keystore): 5E:8F:16:06:2E:A3:CD:2C:4A:0D:54:78:76:BA:A6:F3:8C:AB:F6:25
#   (per altro keystore: cd android && .\gradlew.bat signingReport)
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxxx.apps.googleusercontent.com
#
# (Opzionale: per web build)
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com

# Master: email che usa le chiavi del backend (opzionale se usi solo backend)
EXPO_PUBLIC_MASTER_EMAIL=

# Beta tester: ogni avvio con utente non loggato mostra prima la schermata "Scegli la lingua" (come primo accesso). Per produzione lasciare false o non impostare.
# EXPO_PUBLIC_BETA_ALWAYS_SHOW_LANGUAGE_FIRST=true

# Fase 1 (solo free, Play Store): impostare a false per nascondere upgrade/abbonamenti e mostrare solo "Prova gratis" + "Condividi OXY" (50% sconto futuro).
# true = mostra Abbonamento/Lifetime e pulsanti upgrade; false = solo free, messaggio "Piani in arrivo" e Condividi.
# EXPO_PUBLIC_SHOW_UPGRADE=false

# Distribuzione app: 'subscription' = abbonamento (Oxy Key nascosta, chiave solo sul server) | 'one_time_purchase' = acquisto senza abbonamento (mostra "Inserisci Oxy Key")
# Default: subscription (nessuna chiave sul telefono)
# EXPO_PUBLIC_APP_MODE=subscription
# EXPO_PUBLIC_APP_MODE=one_time_purchase

# Ospiti: chiave OpenAI in app (opzionale se tutti usano backend con propria chiave)
# EXPO_PUBLIC_OXY_AI_KEY=
# Tavily (ricerca web) in app — opzionale se usi solo backend
# EXPO_PUBLIC_TAVILY_API_KEY=
